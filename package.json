{
  "name": "catlog-shared-transaction-layer-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:reporting": "node --test scripts/reconciliation-evidence.test.mjs",
    "test": "node --env-file-if-exists=.env.catlog scripts/run-catlog.mjs",
    "test:report": "npm test",
    "test:backend": "vitest run",
    "test:backend:report": "vitest run --reporter=verbose --reporter=junit --outputFile=./reports/junit.xml",
    "test:testnet": "vitest run --config vitest.testnet.config.ts",
    "test:cctp": "vitest run --config vitest.cctp.config.ts",
    "test:cctp:return": "vitest run --config vitest.cctp-return.config.ts",
    "wallet:testnet": "node --experimental-strip-types tests/cctp/create-wallet.ts",
    "test:operations": "vitest run --config vitest.operations.config.ts",
    "test:private": "node scripts/run-private-tests.mjs",
    "test:handoff": "node --test scripts/private-report.test.mjs && vitest run --config vitest.handoff.config.ts",
    "test:catlog": "node --env-file-if-exists=.env.catlog scripts/run-catlog.mjs",
    "live:create": "node --env-file-if-exists=.env.catlog catlog/live.mjs create",
    "live:status": "node --env-file-if-exists=.env.catlog catlog/live.mjs status"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "@types/node": "22.20.5",
    "ethers": "6.17.0",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
